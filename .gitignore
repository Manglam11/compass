# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Golden data (may contain real resumes)
data/golden/*
!data/golden/.gitkeep

# Resume files (never committed — labels reference them by hash only)
resumes/

# Explicit name lists for redaction (PII — never committed)
names.txt
*.names.txt

# Generated documents
*.pdf
